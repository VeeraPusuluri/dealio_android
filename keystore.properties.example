# Copy to keystore.properties (which is gitignored) and fill in.
# Paths are relative to the repository root.
#
# To create an upload key:
#   keytool -genkeypair -v -keystore dealio-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias dealio-upload
#
# Back up the .jks and these passwords somewhere durable. With Play App Signing
# a lost upload key can be reset by Google; without it, losing the key means the
# listing can never be updated again.

storeFile=dealio-upload.jks
storePassword=
keyAlias=dealio-upload
keyPassword=
